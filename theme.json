{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "no-title",
			"title": "No Title Template",
			"postTypes": [
				"page",
				"post"
			]
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"slug": "navy",
					"name": "Navy",
					"color": "#15294e"
				},
				{
					"slug": "navy-deep",
					"name": "Navy Deep",
					"color": "#031a43"
				},
				{
					"slug": "navy-band",
					"name": "Navy Band",
					"color": "#192d52"
				},
				{
					"slug": "navy-footer",
					"name": "Navy Footer",
					"color": "#14234b"
				},
				{
					"slug": "gold",
					"name": "Gold",
					"color": "#cf9123"
				},
				{
					"slug": "gold-soft",
					"name": "Gold Soft",
					"color": "#f3e2c4"
				},
				{
					"slug": "green",
					"name": "Green",
					"color": "#11aa63"
				},
				{
					"slug": "blue",
					"name": "Blue",
					"color": "#4a79fb"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#000000"
				},
				{
					"slug": "body-text",
					"name": "Body Text",
					"color": "#1c1c1c"
				},
				{
					"slug": "text-navy",
					"name": "Text Navy",
					"color": "#1a2b5e"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#555555"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#e4e4e4"
				},
				{
					"slug": "card",
					"name": "Card",
					"color": "#f5f5f5"
				},
				{
					"slug": "lavender",
					"name": "Lavender",
					"color": "#eaebff"
				},
				{
					"slug": "peach",
					"name": "Peach",
					"color": "#fef3e1"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				}
			]
		},
		"custom": {
			"spacing": {
				"small": "clamp(20px, 4vw, 40px)",
				"medium": "clamp(48px, 8vw, 100px)",
				"large": "clamp(100px, 12vw, 460px)",
				"outer": "min(4vw, 90px)"
			},
			"radius": "14px"
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Montserrat",
					"slug": "montserrat",
					"fontFamily": "Montserrat, \"Montserrat Fallback\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/montserrat-latin-var.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, \"Inter Fallback\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-var.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "normal",
					"name": "Normal",
					"size": "1rem"
				},
				{
					"fluid": {
						"min": "0.875rem",
						"max": "1rem"
					},
					"size": "1rem",
					"slug": "small",
					"name": "Small"
				},
				{
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					},
					"size": "1.125rem",
					"slug": "medium",
					"name": "Medium"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.75rem"
					},
					"size": "1.75rem",
					"slug": "large",
					"name": "Large"
				},
				{
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					},
					"size": "2.25rem",
					"slug": "x-large",
					"name": "X Large"
				},
				{
					"fluid": {
						"min": "3rem",
						"max": "4.5rem"
					},
					"size": "4.5rem",
					"slug": "xx-large",
					"name": "Xx Large"
				}
			],
			"customFontSize": false
		},
		"layout": {
			"contentSize": "1020px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			],
			"customSpacingSize": false
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-comments": {
				"elements": {
					"h3": {
						"typography": {
							"textTransform": "uppercase"
						}
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--spacing--small)"
					}
				}
			},
			"core/post-navigation-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"textTransform": "uppercase"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/pullquote": {
				"border": {
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--spacing--medium)",
						"bottom": "var(--wp--custom--spacing--medium)"
					}
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"core/quote": {
				"border": {
					"width": "1px"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--line)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)",
					"fontWeight": "600",
					"textTransform": "uppercase"
				}
			},
			"core/post-content": {
				"spacing": {
					"blockGap": "0"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--body-text)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius)"
				},
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontSize": "var(--wp--preset--font-size--normal)",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--navy-deep)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--navy-deep)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--navy-deep)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":visited": {
					"color": {
						"text": "var(--wp--preset--color--white)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"right": "var(--wp--custom--spacing--small)",
				"bottom": "0",
				"left": "var(--wp--custom--spacing--small)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"fontWeight": "400",
			"lineHeight": "1.6",
			"letterSpacing": "-0.1px"
		},
		"css": "/* Header, content and footer sit flush: the page is built from full-width IMET sections that carry their own spacing. */\n.wp-site-blocks > * { margin-block: 0; }"
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
