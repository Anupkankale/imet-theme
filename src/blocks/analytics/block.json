{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imet/analytics",
	"title": "IMET Image + Bullet List",
	"category": "imet",
	"icon": "analytics",
	"description": "Image beside an Insights header, dotted list and button.",
	"keywords": [
		"imet",
		"section"
	],
	"version": "1.0.0",
	"textdomain": "imet-theme",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"full"
		]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"imet": {
		"tagName": "section",
		"className": "section analytics",
		"anchor": ""
	},
	"editorScript": "file:./index.js",
	"style": [
		"imet-base",
		"file:./style-index.css"
	]
}
