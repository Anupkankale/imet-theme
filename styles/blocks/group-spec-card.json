{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Link card (offset shadow)",
	"slug": "group-spec-card",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"border": {
			"radius": "12px"
		},
		"shadow": "var(--wp--preset--shadow--offset)",
		"spacing": {
			"padding": {
				"top": "12px",
				"bottom": "12px",
				"left": "20px",
				"right": "54px"
			}
		},
		"typography": {
			"fontSize": "1.03125rem",
			"fontWeight": "500",
			"lineHeight": "1.3"
		}
	}
}
