{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Card",
	"slug": "group-card",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)"
		},
		"border": {
			"radius": "var(--wp--custom--radius)",
			"color": "var(--wp--preset--color--line)",
			"width": "1px",
			"style": "solid"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--24)",
				"bottom": "var(--wp--preset--spacing--24)",
				"left": "var(--wp--preset--spacing--24)",
				"right": "var(--wp--preset--spacing--24)"
			}
		},
		"shadow": "var(--wp--preset--shadow--soft)"
	}
}
